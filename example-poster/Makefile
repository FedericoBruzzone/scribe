.PHONY: help all compile_main force_compile_main clean clean_pdf run_interactive

NAME = main

# =============== HELP ===============
help:
	@echo "Usage:"
	@echo "  make all                - compile main file"
	@echo "  make compile_main       - compile main file"
	@echo "  make force_compile_main - force compile main file"
	@echo "  make clean              - clean all files generated by compilation"
	@echo "  make clean_pdf          - clean all files generated by compilation and pdf files"
	@echo "  make run_interactive    - run latexmk in interactive mode"

# =============== TARGETS ===============
all: clean compile_main

compile_main: $(NAME).tex
	$(call compile_main, $<)

force_compile_main: $(NAME).tex
	$(call force_compile_main, $<)

clean:
	$(call clean_main)

clean_pdf:
	$(call clean_main_pdf)

run_interactive:
	latexmk -pdf -pvc -shell-escape -interaction=nonstopmode -file-line-error ./$(NAME).tex

# =============== COMPILING ===============
define xelatex_cmd
	xelatex -shell-escape -file-line-error -output-directory=$(dir $1) $1
endef

define bibtex_cmd
	bibtex $(basename $1)
endef

define compile_main
	-$(call xelatex_cmd, $1)
	$(call bibtex_cmd, $1)
	-$(call xelatex_cmd, $1)
	-$(call xelatex_cmd, $1)
endef

define force_compile_main
	-xelatex -shell-escape -interaction=nonstopmode -file-line-error -output-directory=$(dir $1) $1
	-bibtex $(basename $1)
	-xelatex -shell-escape -interaction=nonstopmode -file-line-error -output-directory=$(dir $1) $1
	-xelatex -shell-escape -interaction=nonstopmode -file-line-error -output-directory=$(dir $1) $1
endef

# =============== CLEANING ===============
define clean_main
	rm -rf *.aux *.bbl *.blg *.log *.out *.spl *.synctex.gz *.toc *.bcf *.run.xml *.nav *.snm *.vrb *.fdb_latexmk *.fls
endef

define clean_main_pdf
	$(call clean_main)
	rm -rf $(NAME).pdf
endef
